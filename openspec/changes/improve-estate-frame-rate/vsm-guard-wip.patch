+void AHomesteadWorld::ApplyVirtualShadowMapSunLimits()
+{
+    // Without ray tracing the sun falls back to Virtual Shadow Maps, and their first frame on the
+    // Estate (every page uncached) sent Nanite's node-and-cluster culling of the dense wood past
+    // Windows' 2 s GPU timeout: the device was removed on frame 2, every run. Measured with ray tracing
+    // off (improve-estate-frame-rate): coarse pages off, single-pass Nanite culling and a resolution bias
+    // of 1 all still timed out; a bias of 3 with the clipmap ending at level 18 (~2.6 km) played the
+    // whole EstateSmoke route. Only the directional lights' VSMs change; ray-traced play (Jenny's) never
+    // reaches this. Set once, at game-setting priority, so console and ini overrides still win.
+    if (bVirtualShadowMapSunLimited) return;
+    bVirtualShadowMapSunLimited = true;
+    constexpr float SunVsmResolutionLodBias = 3.0f;
+    constexpr int32 SunVsmLastClipmapLevel = 18;
+    if (IConsoleVariable* Bias = IConsoleManager::Get().FindConsoleVariable(TEXT("r.Shadow.Virtual.ResolutionLodBiasDirectional")))
+        Bias->Set(SunVsmResolutionLodBias, ECVF_SetByGameSetting);
+    if (IConsoleVariable* Last = IConsoleManager::Get().FindConsoleVariable(TEXT("r.Shadow.Virtual.Clipmap.LastLevel")))
+        Last->Set(SunVsmLastClipmapLevel, ECVF_SetByGameSetting);
+    UE_LOG(LogHomesteadWorld, Display, TEXT("Sun uses Virtual Shadow Maps: ResolutionLodBiasDirectional=%.1f Clipmap.LastLevel=%d (GPU timeout guard)."),
+        SunVsmResolutionLodBias, SunVsmLastClipmapLevel);
+}
