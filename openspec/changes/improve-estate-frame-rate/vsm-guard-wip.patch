@@ -189,11 +190,13 @@ $arguments += @(
 # reset the driver (DXGI_ERROR_DEVICE_REMOVED / DRIVER_INTERNAL_ERROR), taking every Unreal process
 # down with it, so agent editors render without ray tracing unless -RayTracing is passed.
